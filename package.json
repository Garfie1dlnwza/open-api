{
  "name": "thai-open-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @thai-open-api/web",
    "build": "npm run catalog:build && npm run build -w @thai-open-api/web",
    "catalog:validate": "tsx scripts/validate-catalog.ts",
    "catalog:build": "tsx scripts/build-worker-catalog.ts",
    "health": "tsx scripts/health-check.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "check:hardcoded": "node scripts/check-hardcoded.mjs",
    "check:dup": "jscpd --config .jscpd.json",
    "test": "vitest run",
    "check": "npm run catalog:validate && npm run catalog:build && npm run typecheck && npm run lint && npm run check:hardcoded && npm run check:dup && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "jscpd": "^5.4.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
