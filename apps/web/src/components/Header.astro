---
import { LOCALES, type Locale } from "@thai-open-api/schema";
import { SearchCommand } from "./SearchCommand.tsx";
import { Moon, Sun } from "lucide-react";
import { LOCALE_NAMES, ROUTES, SITE } from "../config/site.ts";
import { createT } from "../i18n/index.ts";
import { switchLocalePath } from "../lib/locale.ts";

interface Props {
  locale: Locale;
  wide?: boolean;
}
const { locale, wide } = Astro.props;
const t = createT(locale);
const path = Astro.url.pathname;
const links = [
  { href: ROUTES.explore(locale), label: t("nav.explore"), active: path.startsWith(ROUTES.explore(locale)) },
  { href: ROUTES.dashboard(locale), label: t("nav.dashboard"), active: path.startsWith(ROUTES.dashboard(locale)) },
  { href: ROUTES.contribute(), label: t("nav.contribute"), active: false },
  { href: SITE.repoUrl, label: t("nav.github"), active: false },
];
const linkClass = (active: boolean) => [
  "relative whitespace-nowrap px-3 py-2 text-small font-medium transition-colors duration-150",
  "after:absolute after:inset-x-3 after:-bottom-px after:h-0.5 after:rounded-full after:bg-link after:transition-transform after:duration-200 after:origin-left",
  active ? "text-link after:scale-x-100" : "text-ink-2 hover:text-ink after:scale-x-0 hover:after:scale-x-100 hover:after:bg-line-strong",
];
---

<div aria-hidden="true" class="flag-stripe h-1"></div>
<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur">
  <div class:list={["mx-auto flex h-[var(--header-height)] items-center gap-4 px-5 sm:px-8", wide ? "max-w-[var(--detail-page-max)]" : "max-w-[var(--content-max)]"]}>
    <a href={ROUTES.home(locale)} class="flex shrink-0 items-center gap-2.5" aria-label={t("site.name")}>
      <img src="/brand/mark.png" alt="" width="36" height="33" class="h-9 w-auto" />
      <span class="hidden text-[17px] font-bold leading-none tracking-tight sm:block">
        <span class="text-flag-fg">Thai</span> <span class="text-ink">Open</span> <span class="text-link">API</span>
      </span>
    </a>
    <nav aria-label={t("nav.mainNavigation")} class="ml-4 hidden items-center lg:flex">
      {links.map((link) => <a href={link.href} aria-current={link.active ? "page" : undefined} class:list={linkClass(link.active)}>{link.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-4">
      <SearchCommand client:idle locale={locale} />
      <button type="button" data-theme-toggle aria-pressed="false" aria-label={t("theme.toggle")} title={t("theme.dark")} class="grid size-10 place-items-center rounded-md border border-control bg-surface text-ink-2 transition-colors duration-150 hover:bg-subtle hover:text-ink">
        <Sun aria-hidden size={18} className="hidden dark:block" />
        <Moon aria-hidden size={18} className="dark:hidden" />
      </button>
      <nav aria-label={t("nav.language")} class="flex items-center gap-1 text-small">
        {LOCALES.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-line-strong">/</span>}
            <a href={`${switchLocalePath(path, l)}${Astro.url.search}`} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined} class:list={["tap rounded-sm px-2 transition-colors duration-150", l === locale ? "font-semibold text-ink" : "text-ink-3 hover:text-ink"]}>
              {LOCALE_NAMES[l]}
            </a>
          </>
        ))}
      </nav>
    </div>
  </div>
  <nav aria-label={t("nav.mainNavigation")} class="flex overflow-x-auto border-t border-line px-3 lg:hidden">
    {links.map((link) => <a href={link.href} aria-current={link.active ? "page" : undefined} class:list={linkClass(link.active)}>{link.label}</a>)}
  </nav>
</header>

<script>
  import { STORAGE } from "../config/site.ts";

  // The pre-paint script already set data-theme; this wires the button and follows the OS until the visitor chooses.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const apply = (theme: "dark" | "light") => {
    root.dataset.theme = theme;
    button?.setAttribute("aria-pressed", String(theme === "dark"));
  };
  const saved = () => {
    try {
      return localStorage.getItem(STORAGE.theme);
    } catch {
      return null;
    }
  };
  apply(root.dataset.theme === "dark" ? "dark" : "light");
  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    apply(next);
    try {
      localStorage.setItem(STORAGE.theme, next);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
  });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    if (!saved()) apply(event.matches ? "dark" : "light");
  });
</script>
