---
import { LOCALES, type Locale } from "@thai-open-api/schema";
import { SearchCommand } from "./SearchCommand.tsx";
import { Moon } from "lucide-react";
import { LOCALE_NAMES, ROUTES, SITE } from "../config/site.ts";
import { createT } from "../i18n/index.ts";
import { switchLocalePath } from "../lib/locale.ts";

interface Props {
  locale: Locale;
  wide?: boolean;
}
const { locale, wide } = Astro.props;
const t = createT(locale);
const path = Astro.url.pathname;
const links = [
  { href: ROUTES.explore(locale), label: t("nav.explore"), active: path.startsWith(ROUTES.explore(locale)) },
  { href: ROUTES.dashboard(locale), label: t("nav.dashboard"), active: path.startsWith(ROUTES.dashboard(locale)) },
  { href: ROUTES.contribute(), label: t("nav.contribute"), active: false },
  { href: SITE.repoUrl, label: t("nav.github"), active: false },
];
// Segmented-control look: the current page is a raised pill on a quiet track, as in macOS.
const track = "rounded-full border border-line/60 bg-subtle/70 p-1";
const pill = (active: boolean) => [
  "tap whitespace-nowrap rounded-full px-3.5 text-small font-medium transition-colors duration-150 min-h-8",
  active ? "bg-surface text-ink shadow-sm" : "text-ink-2 hover:text-ink",
];
---

<div aria-hidden="true" class="flag-stripe h-1"></div>
<header class="glass-bar sticky top-0 z-40 border-b border-line/60">
  <div class:list={["mx-auto flex h-[var(--header-height)] items-center gap-4 px-5 sm:px-8", wide ? "max-w-[var(--detail-page-max)]" : "max-w-[var(--content-max)]"]}>
    <a href={ROUTES.home(locale)} class="flex shrink-0 items-center gap-2.5" aria-label={t("site.name")}>
      <img src="/brand/mark.png" alt="" width="36" height="33" class="h-9 w-auto" />
      <span class="hidden text-[17px] font-bold leading-none tracking-tight sm:block">
        <span class="text-flag-fg">Thai</span> <span class="text-ink">Open</span> <span class="text-link">API</span>
      </span>
    </a>
    <nav aria-label={t("nav.mainNavigation")} class:list={["ml-4 hidden items-center lg:flex", track]}>
      {links.map((link) => <a href={link.href} aria-current={link.active ? "page" : undefined} class:list={pill(link.active)}>{link.label}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <SearchCommand client:idle locale={locale} />
      <button type="button" data-theme-toggle aria-pressed="false" aria-label={t("theme.dark")} title={t("theme.dark")} class="grid size-10 place-items-center rounded-full border border-line/60 bg-subtle/70 text-ink-2 transition-colors duration-150 hover:text-ink aria-pressed:bg-surface aria-pressed:text-brand-fg aria-pressed:shadow-sm">
        <Moon aria-hidden size={18} />
      </button>
      <nav aria-label={t("nav.language")} class:list={["flex items-center text-small", track, "p-0.5"]}>
        {LOCALES.map((l) => (
          <a href={`${switchLocalePath(path, l)}${Astro.url.search}`} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined} class:list={["tap rounded-full px-3 transition-colors duration-150 min-h-8", l === locale ? "bg-surface font-semibold text-ink shadow-sm" : "text-ink-3 hover:text-ink"]}>
            {LOCALE_NAMES[l]}
          </a>
        ))}
      </nav>
    </div>
  </div>
  <nav aria-label={t("nav.mainNavigation")} class="overflow-x-auto px-5 pb-2 sm:px-8 lg:hidden">
    <div class:list={["flex w-max", track]}>
      {links.map((link) => <a href={link.href} aria-current={link.active ? "page" : undefined} class:list={pill(link.active)}>{link.label}</a>)}
    </div>
  </nav>
</header>

<script>
  import { STORAGE } from "../config/site.ts";

  // The pre-paint script already set data-theme; this wires the button and follows the OS until the visitor chooses.
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const apply = (theme: "dark" | "light") => {
    root.dataset.theme = theme;
    button?.setAttribute("aria-pressed", String(theme === "dark"));
  };
  const saved = () => {
    try {
      return localStorage.getItem(STORAGE.theme);
    } catch {
      return null;
    }
  };
  apply(root.dataset.theme === "dark" ? "dark" : "light");
  button?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    apply(next);
    try {
      localStorage.setItem(STORAGE.theme, next);
    } catch {
      /* storage blocked: the choice lasts for this page only */
    }
  });
  matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    if (!saved()) apply(event.matches ? "dark" : "light");
  });
</script>
