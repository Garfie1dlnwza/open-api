---
import { DEFAULT_LOCALE, LOCALES } from "@thai-open-api/schema";
import { ROUTES } from "../config/site.ts";
import { createT } from "../i18n/index.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

// The server cannot know the visitor's language here, so the page speaks both.
const t = createT(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")}>
  <div class="mx-auto flex max-w-[var(--content-max)] flex-col gap-10 px-5 py-24 sm:px-8">
    {LOCALES.map((l) => {
      const tl = createT(l);
      return (
        <section lang={l} class="flex flex-col items-start gap-3">
          <h1 class="text-h1 font-bold tracking-tight">{tl("notFound.title")}</h1>
          <p class="text-ink-2">{tl("notFound.body")}</p>
          <a href={ROUTES.home(l)} class="text-small font-medium text-link hover:underline">{tl("notFound.home")}</a>
        </section>
      );
    })}
  </div>
</BaseLayout>
