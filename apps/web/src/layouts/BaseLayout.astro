---
import { LOCALES, type Locale } from "@thai-open-api/schema";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config/site.ts";
import { createT } from "../i18n/index.ts";
import { switchLocalePath } from "../lib/locale.ts";
import "../styles/globals.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const t = createT(locale);
const pageTitle = title ? `${title} · ${t("site.name")}` : `${t("site.name")} · ${t("site.tagline")}`;
const pageDescription = description ?? t("site.description");
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocalePath(Astro.url.pathname, l), SITE.url).href} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-800 focus:px-4 focus:py-2 focus:text-on-brand">
      {t("nav.skipToContent")}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
