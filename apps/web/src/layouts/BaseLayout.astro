---
import { LOCALES, type Locale } from "@thai-open-api/schema";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE, STORAGE } from "../config/site.ts";
import { createT } from "../i18n/index.ts";
import { switchLocalePath } from "../lib/locale.ts";
import "../styles/globals.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Use the wider detail-page container so the header lines up with a three-column page. */
  wide?: boolean;
}
const { locale, title, description, wide } = Astro.props;
const t = createT(locale);
const pageTitle = title ? `${title} · ${t("site.name")}` : `${t("site.name")} · ${t("site.tagline")}`;
const pageDescription = description ?? t("site.description");
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const image = new URL("/brand/og.png", SITE.url).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="light dark" />
    <!-- Runs before first paint so a dark visitor never sees a flash of light. A saved choice wins over the OS. -->
    <script is:inline define:vars={{ themeKey: STORAGE.theme }}>
      (function () {
        var dark = false;
        try {
          var saved = localStorage.getItem(themeKey);
          dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        } catch (e) {
          try { dark = matchMedia("(prefers-color-scheme: dark)").matches; } catch (e2) {}
        }
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/favicon-192.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocalePath(Astro.url.pathname, l), SITE.url).href} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={t("site.name")} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-fill focus:px-4 focus:py-2 focus:text-on-brand">
      {t("nav.skipToContent")}
    </a>
    <Header locale={locale} wide={wide} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
