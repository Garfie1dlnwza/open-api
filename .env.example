# Copy to apps/web/.env for local development. Only PUBLIC_* values reach the browser.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_REPO_URL=https://github.com/Garfie1dlnwza/open-api
# Leave empty to disable the playground; the docs and code samples keep working.
PUBLIC_PLAYGROUND_URL=http://127.0.0.1:8787/v1/playground
